{
  "name": "kiminini-sportif-fc",
  "version": "1.0.0",
  "description": "Official web platform for Kiminini Sportif FC — fixtures, membership, matchday engine, and club administration.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node --env-file=.env -e \"require('child_process').execSync('psql -U ' + process.env.PGUSER + ' -d ' + process.env.PGDATABASE + ' -f db/schema.sql', {stdio: 'inherit'})\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.1.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
