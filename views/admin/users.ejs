

<main class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 font-weight-bold mb-0">User Management</h1>
      <p class="text-muted small mb-0">Manage club accounts, provision roles, and issue temporary access credentials.</p>
    </div>
    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#provisionUserModal">
      + Provision New Account
    </button>
  </div>

  <!-- Flash Messages -->
  <% if (messages.error && messages.error.length > 0) { %>
    <% messages.error.forEach(function(msg) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= msg %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
    <% }); %>
  <% } %>

  <% if (messages.success && messages.success.length > 0) { %>
    <% messages.success.forEach(function(msg) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= msg %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
    <% }); %>
  <% } %>

  <!-- Users Table -->
  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="thead-light">
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Role</th>
              <th>Membership Status</th>
              <th>Security State</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length > 0) { %>
              <% users.forEach(function(user) { %>
                <tr>
                  <td>
                    <span class="font-weight-bold d-block"><%= user.full_name %></span>
                  </td>
                  <td><%= user.email %></td>
                  <td><%= user.phone_number || '—' %></td>
                  <td>
                    <span class="badge badge-secondary text-uppercase"><%= user.role_name %></span>
                  </td>
                  <td>
                    <% if (user.is_membership_active) { %>
                      <span class="badge badge-success">Active</span>
                    <% } else { %>
                      <span class="badge badge-warning">Inactive / Pending Dues</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (user.must_change_password) { %>
                      <span class="badge badge-danger">Password Change Required</span>
                    <% } else { %>
                      <span class="badge badge-light border text-muted">Standard</span>
                    <% } %>
                  </td>
                  <td class="text-right">
                    <button 
                      type="button" 
                      class="btn btn-sm btn-outline-secondary" 
                      data-toggle="modal" 
                      data-target="#resetPasswordModal-<%= user.id %>">
                      Reset Password
                    </button>

                    <!-- Reset Password Modal -->
                    <div class="modal fade text-left" id="resetPasswordModal-<%= user.id %>" tabindex="-1" role="dialog" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                          <form action="/admin/users/<%= user.id %>/reset-password" method="POST">
                            <div class="modal-header">
                              <h5 class="modal-title">Reset Password for <%= user.full_name %></h5>
                              <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                              </button>
                            </div>
                            <div class="modal-body">
                              <p class="small text-muted mb-3">Set a new temporary password. The user will be required to update this password upon their next login.</p>
                              <div class="form-group mb-3">
                                <label for="tempPassword-<%= user.id %>" class="form-label font-weight-bold">Temporary Password</label>
                                <input 
                                  type="password" 
                                  class="form-control" 
                                  id="tempPassword-<%= user.id %>" 
                                  name="tempPassword" 
                                  placeholder="At least 8 characters" 
                                  required 
                                  minlength="8"
                                />
                              </div>
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-primary">Set Temporary Password</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>

                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-4 text-muted">No users found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<!-- Provision User Modal -->
<div class="modal fade" id="provisionUserModal" tabindex="-1" role="dialog" aria-labelledby="provisionUserModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
    <div class="modal-content">
      <form action="/admin/users" method="POST" class="needs-validation" novalidate>
        <div class="modal-header">
          <h5 class="modal-title font-weight-bold" id="provisionUserModalLabel">Provision New Account</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <p class="small text-muted mb-4">
            Provision an account for official team roles (players, coaches, TMs, treasurers, or admins). Accounts created here will be assigned a temporary password and flagged for a forced password change on first login.
          </p>
          
          <div class="row">
            <div class="col-md-6 form-group mb-3">
              <label for="fullName" class="form-label font-weight-bold">Full Name</label>
              <input type="text" class="form-control" id="fullName" name="fullName" placeholder="e.g. John Doe" required />
            </div>

            <div class="col-md-6 form-group mb-3">
              <label for="email" class="form-label font-weight-bold">Email Address</label>
              <input type="email" class="form-control" id="email" name="email" placeholder="e.g. john@kimininisportif.co.ke" required />
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 form-group mb-3">
              <label for="phoneNumber" class="form-label font-weight-bold">Phone Number</label>
              <input type="text" class="form-control" id="phoneNumber" name="phoneNumber" placeholder="e.g. 0712345678" />
            </div>

            <div class="col-md-6 form-group mb-3">
              <label for="role" class="form-label font-weight-bold">Role Assignment</label>
              <select class="form-control" id="role" name="role" required>
                <option value="" disabled selected>Select a role...</option>
                <% if (roles && roles.length > 0) { %>
                  <% roles.forEach(function(r) { %>
                    <option value="<%= r.name %>"><%= r.name.toUpperCase() %></option>
                  <% }); %>
                <% } else { %>
                  <option value="fan">FAN</option>
                  <option value="player">PLAYER</option>
                  <option value="coach">COACH</option>
                  <option value="tm">TM</option>
                  <option value="treasurer">TREASURER</option>
                  <option value="admin">ADMIN</option>
                <% } %>
              </select>
            </div>
          </div>

          <div class="form-group mb-3">
            <label for="tempPassword" class="form-label font-weight-bold">Initial Temporary Password</label>
            <input 
              type="password" 
              class="form-control" 
              id="tempPassword" 
              name="tempPassword" 
              placeholder="At least 8 characters" 
              required 
              minlength="8" 
            />
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Provision Account</button>
        </div>
      </form>
    </div>
  </div>
</div>

