<div class="dashboard-head">
  <div class="dashboard-head__title">
    <span class="role-pill"><%= role %></span>
    <h1>Welcome back, <%= currentUser.full_name.split(' ')[0] %></h1>
  </div>

  <% if (role === 'admin') { %>
    <div class="dashboard-tabs">
      <button class="tab-btn active" onclick="switchTab('overview')">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
        Overview
      </button>
      <button class="tab-btn" onclick="switchTab('user-management')">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        User Management
      </button>
    </div>
  <% } %>
</div>

<div class="dashboard-container">
  <!-- TAB 1: OVERVIEW DASHBOARD -->
  <div id="tab-overview" class="tab-content active">
    <div class="dashboard-grid">

      <% if (role === 'fan') { %>
        <div class="card card--glass span-full">
          <h3>Fan Hub</h3>
          <p>Vote for Player of the Match after every game and join the matchday chat.</p>
          <% if (typeof latestFixture !== 'undefined' && latestFixture) { %>
            <p>Latest result: Kiminini <%= latestFixture.our_score %> &ndash; <%= latestFixture.opponent_score %> <%= latestFixture.opponent %></p>
            <a href="/fixtures" class="btn btn--emerald">Vote for POTM</a>
          <% } else { %>
            <p>No completed matches yet to vote on.</p>
          <% } %>
        </div>
      <% } %>

      <% if (['player','coach','tm'].includes(role)) { %>
        <div class="stat-card">
          <div class="value"><%= membershipActive ? 'Active' : 'Pending' %></div>
          <div class="label">Membership Status</div>
          <% if (!membershipActive) { %>
            <p style="margin-top:10px;"><a href="/pay-dues" class="btn btn--gold">Pay Dues to Unlock</a></p>
          <% } %>
        </div>
        <div class="card card--glass">
          <h3>Next Fixture</h3>
          <% if (typeof nextFixture !== 'undefined' && nextFixture) { %>
            <p>vs <%= nextFixture.opponent %> &mdash; <%= new Date(nextFixture.match_date).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' }) %></p>
            <p><%= nextFixture.venue || 'Venue TBC' %></p>
          <% } else { %>
            <p>No upcoming fixture scheduled.</p>
          <% } %>
        </div>
        <% if (['coach','tm'].includes(role) && membershipActive) { %>
          <div class="card card--glass">
            <h3>Matchday Tools</h3>
            <p>Update the tactical lineup board or log live match events.</p>
            <a href="/fixtures" class="btn btn--emerald">Open Matchday Engine</a>
          </div>
        <% } %>
      <% } %>

      <% if (role === 'treasurer' || role === 'admin') { %>
        <div class="stat-card">
          <div class="value">KES <%= Number(totalCollected || 0).toLocaleString() %></div>
          <div class="label">Total Collected</div>
        </div>
        <div class="card card--glass span-full">
          <h3>Recent Payments</h3>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr><th>Member</th><th>Amount</th><th>Type</th><th>Status</th><th>Date</th></tr>
              </thead>
              <tbody>
                <% if (typeof recentPayments !== 'undefined' && recentPayments.length) { %>
                  <% recentPayments.forEach(p => { %>
                    <tr>
                      <td><%= p.full_name %></td>
                      <td>KES <%= Number(p.amount).toLocaleString() %></td>
                      <td><%= p.payment_type.replace('_', ' ') %></td>
                      <td><span class="status-pill status-pill--<%= p.status %>"><%= p.status %></span></td>
                      <td><%= new Date(p.created_at).toLocaleDateString('en-GB') %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="5" class="empty-cell">No recent payments logged.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <p style="margin-top:16px;"><a href="/reports/financial" class="btn btn--ghost">Open Printable Report</a></p>
        </div>
      <% } %>

      <% if (role === 'admin') { %>
        <div class="card card--glass span-full">
          <h3>Pending Membership Approvals</h3>
          <div class="table-responsive">
            <table class="data-table">
              <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th></tr></thead>
              <tbody>
                <% if (typeof pendingApprovals !== 'undefined' && pendingApprovals.length) { %>
                  <% pendingApprovals.forEach(u => { %>
                    <tr>
                      <td><%= u.full_name %></td>
                      <td><%= u.email %></td>
                      <td><%= u.role_name %></td>
                      <td><span class="status-pill status-pill--pending">awaiting payment</span></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="4" class="empty-cell">No pending approvals.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

    </div>
  </div>

  <!-- TAB 2: ADMIN USER MANAGEMENT -->
  <% if (role === 'admin') { %>
    <div id="tab-user-management" class="tab-content">
      <div class="admin-grid">
        
        <!-- Provision Account Form Card -->
        <div class="card card--glass">
          <div class="card-header">
            <h3>Provision New User</h3>
            <p>Create active club credentials for players, coaches, or staff.</p>
          </div>
          <form action="/admin/users" method="POST" class="form-stack">
            <div class="form-group">
              <label for="full_name">Full Name</label>
              <input type="text" id="full_name" name="full_name" placeholder="e.g. Victor Wanyama" required>
            </div>
            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" placeholder="user@kimininisportif.co.ke" required>
            </div>
            <div class="form-group">
              <label for="role_id">Assigned Role</label>
              <select id="role_id" name="role_id" required>
                <option value="" disabled selected>Select Role</option>
                <option value="1">Admin</option>
                <option value="2">Treasurer</option>
                <option value="3">Team Manager (TM)</option>
                <option value="4">Coach</option>
                <option value="5">Player</option>
                <option value="6">Fan</option>
              </select>
            </div>
            <div class="form-group">
              <label for="temp_password">Temporary Password</label>
              <input type="text" id="temp_password" name="temp_password" value="ChangeMe2026!" required>
            </div>
            <button type="submit" class="btn btn--gold btn--block">Create User Account</button>
          </form>
        </div>

        <!-- All Users Directory Table -->
        <div class="card card--glass">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h3>System Accounts</h3>
            <span class="badge badge--home"><%= typeof allUsers !== 'undefined' ? allUsers.length : 0 %> Total</span>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>User</th>
                  <th>Role</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (typeof allUsers !== 'undefined' && allUsers.length) { %>
                  <% allUsers.forEach(u => { %>
                    <tr>
                      <td>
                        <div class="user-cell">
                          <strong class="user-cell__name"><%= u.full_name %></strong>
                          <span class="user-cell__email"><%= u.email %></span>
                        </div>
                      </td>
                      <td><span class="role-tag"><%= u.role_name %></span></td>
                      <td>
                        <span class="status-pill status-pill--<%= u.is_active ? 'completed' : 'failed' %>">
                          <%= u.is_active ? 'Active' : 'Disabled' %>
                        </span>
                      </td>
                      <td>
                        <div class="action-buttons">
                          <form action="/admin/users/<%= u.id %>/reset-password" method="POST" style="display:inline;" onsubmit="return confirm('Reset password for <%= u.full_name %>?');">
                            <button type="submit" class="btn-icon" title="Reset Password">
                              <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 0121 9z"/></svg>
                            </button>
                          </form>
                          <form action="/admin/users/<%= u.id %>/toggle-status" method="POST" style="display:inline;">
                            <button type="submit" class="btn-icon btn-icon--danger" title="<%= u.is_active ? 'Disable' : 'Enable' %> Account">
                              <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="4" class="empty-cell">No registered users found.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  <% } %>
</div>

<script>
  function switchTab(tabName) {
    document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));

    const activeTab = document.getElementById('tab-' + tabName);
    if (activeTab) activeTab.classList.add('active');

    event.currentTarget.classList.add('active');
  }
</script>