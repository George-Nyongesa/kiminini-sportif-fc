<section class="block">
  <div class="container">
    <div class="section-head"><h2>Results</h2></div>
    <table class="data-table">
      <thead><tr><th>Date</th><th>Fixture</th><th>Score</th><th>Competition</th></tr></thead>
      <tbody>
        <% if (results.length) { %>
          <% results.forEach(fx => { %>
            <tr>
              <td><%= new Date(fx.match_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
              <td>Kiminini Sportif <%= fx.home_away === 'home' ? 'vs' : '@' %> <%= fx.opponent %></td>
              <td><%= fx.our_score %> &ndash; <%= fx.opponent_score %></td>
              <td><%= fx.competition %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="4">No results recorded yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
