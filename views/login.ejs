<div class="auth-wrap">
  <div class="auth-card">
    <h1>Welcome Back</h1>
    <p class="sub">Log in to vote for Player of the Match, check training schedules, or manage the club.</p>

    <div class="social-btns">
      <a href="/auth/google" class="btn--social">Continue with Google</a>
      <a href="/auth/facebook" class="btn--social">Continue with Facebook</a>
    </div>

    <div class="divider">or</div>

    <form action="/login" method="POST">
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email">
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn--emerald btn--block">Log In</button>
    </form>

    <p class="auth-footer-link">New to the club? <a href="/register">Create an account</a></p>
  </div>
</div>
